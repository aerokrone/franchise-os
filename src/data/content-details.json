            "productCard": {
              "sku": "top-left badge",
              "lowStockBadge": "top-right (when applicable)",
              "name": "product name",
              "stockLevel": "Stock: X",
              "price": "RM X.XX",
              "addToCartIcon": "Plus icon",
              "disabledState": "opacity 0.4 when out of stock"
            },
            "products": [
              { "sku": "CP-001", "name": "Ergonomic Wireless Mouse", "cat": "Computing", "price": 79, "stock": 24, "image": "https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?auto=format&fit=crop&w=640&q=80" },
              { "sku": "CP-002", "name": "USB-C 7-in-1 Hub", "cat": "Computing", "price": 149, "stock": 6, "lowStock": true, "image": "https://images.unsplash.com/photo-1625948519841-f312fcd523c4?auto=format&fit=crop&w=640&q=80" },
