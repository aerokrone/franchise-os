              { "sku": "AU-002", "name": "Portable Bluetooth Speaker", "cat": "Audio", "price": 199, "stock": 12, "image": "https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?auto=format&fit=crop&w=640&q=80" },
              { "sku": "AC-001", "name": "65W GaN Charger (2-Port)", "cat": "Accessories", "price": 99, "stock": 19, "image": "https://images.unsplash.com/photo-1583864697804-a9326c10e496?auto=format&fit=crop&w=640&q=80" },
              { "sku": "AC-002", "name": "Braided USB-C Cable 2m", "cat": "Accessories", "price": 45, "stock": 27, "image": "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=640&q=80" }
            ]
          }
        },
        {
          "id": "cart-panel",
          "type": "cart-sidebar",
          "description": "Right-side cart panel with order summary",
          "position": "right-fixed",
          "width": "384px",
          "content": {
            "header": {
              "title": "Current Sale",
              "orderNumber": "#1547"
            },
            "cashierInfo": "Cashier: Ahmad Faizal",
            "customerLookup": {
              "placeholder": "Customer phone (optional)",
              "detectedCustomer": "Sarah Lim · 2,150 pts available",
              "tierBadge": "SILVER"
            },
            "cartItems": {
              "emptyState": "Add items to start a sale",
              "itemRow": {
                "name": "product name",
                "price": "RM X.XX each",
                "quantityControl": ["- button", "qty number", "+ button"],
                "lineTotal": "RM X.XX"
              }
            },
            "orderSummary": {
              "rows": [
                { "label": "Subtotal", "value": "RM X.XX" },
                { "label": "SST 6%", "value": "RM X.XX" },
                { "label": "Total", "value": "RM X.XX", "emphasis": true }
              ]
            },
            "paymentMethods": {
              "title": "Payment Method",
              "buttons": [
                { "icon": "Banknote", "label": "Cash" },
                { "icon": "CreditCard", "label": "Card" },
                { "icon": "Smartphone", "label": "DuitNow" },
                { "icon": "Wallet", "label": "GrabPay" }
              ]
            },
            "checkoutButton": {
              "label": "Complete Sale",
              "icon": "CheckCircle2",
              "showsTotal": true
            }
          }
        }
      ]
    },
    "inventory": {
      "name": "Inventory Management",
      "moduleTitlerowOutlet": {
        "lead": "Stock"
      },
      "moduleTitlerowHq": {
