              { "sku": "CP-004", "name": "FHD 1080p Webcam", "cat": "Computing", "price": 199, "stock": 14, "image": "https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?auto=format&fit=crop&w=640&q=80" },
              { "sku": "MB-001", "name": "10000mAh Power Bank", "cat": "Mobile", "price": 119, "stock": 56, "image": "https://images.unsplash.com/photo-1609091839311-d5365f9ff1c5?auto=format&fit=crop&w=640&q=80" },
              { "sku": "MB-002", "name": "Fitness Smartwatch SE", "cat": "Mobile", "price": 399, "stock": 42, "image": "https://images.unsplash.com/photo-1579586337278-3befd40fd17a?auto=format&fit=crop&w=640&q=80" },
              { "sku": "MB-003", "name": "Foldable Phone Stand", "cat": "Mobile", "price": 49, "stock": 38, "image": "https://images.unsplash.com/photo-1585060286355-d6c6a66c9ad9?auto=format&fit=crop&w=640&q=80" },
