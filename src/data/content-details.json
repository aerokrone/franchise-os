{
  "$schema": "https://content-details.schema/v1",
  "name": "Franchise OS Content Details",
  "version": "1.0.0",
  "description": "Complete hierarchy of user roles, pages, and UI elements for the Franchise OS mockup",
  "users": [
    {
      "role": "hq_admin",
      "label": "HQ Admin",
      "description": "Headquarters administrator with full visibility across all outlets",
      "icon": "Building2",
      "pages": ["dashboard", "ai-bi", "inventory", "customers"]
    },
    {
      "role": "outlet_manager",
      "label": "Outlet Manager",
      "description": "Manager of a specific outlet with full operational control",
      "icon": "Store",
      "pages": ["dashboard", "ai-bi", "pos", "inventory", "customers"]
    },
    {
      "role": "outlet_staff",
      "label": "Outlet Staff",
      "description": "Front-line staff handling daily operations",
      "icon": "User",
      "pages": ["pos", "inventory"]
    },
    {
      "role": "customer",
      "label": "Customer",
      "description": "End customer accessing loyalty program and support",
      "icon": "UserCircle2",
      "pages": ["customer-portal", "ai-customer-chat"]
    }
  ],
  "pages": {
    "login": {
      "name": "Login Screen",
      "description": "Entry point where users select their role to access the system",
      "usedBy": ["all"],
      "elements": [
        {
          "id": "logo-section",
          "type": "branding",
          "description": "Franchise OS logo with gradient background (primary to accent)",
          "content": "Large 'F' letter in white, 'Franchise OS' heading, tagline 'The AI-powered operating system for franchise businesses'"
        },
        {
          "id": "email-field",
          "type": "input",
          "description": "Email address input field",
          "content": "Default: demo@franchise-os.my"
        },
        {
          "id": "password-field",
          "type": "input",
          "description": "Password input field",
          "content": "Masked input showing dots"
        },
        {
          "id": "role-selector",
          "type": "button-group",
          "description": "4 role selection buttons in 2x2 grid",
          "content": [
            { "label": "HQ Admin", "icon": "Building2", "navigatesTo": "dashboard" },
            { "label": "Outlet Manager", "icon": "Store", "navigatesTo": "dashboard" },
            { "label": "Outlet Staff", "icon": "User", "navigatesTo": "pos" },
            { "label": "Customer", "icon": "UserCircle2", "navigatesTo": "shop" }
          ]
        }
      ]
    },
    "dashboard": {
      "name": "Operations Overview Dashboard",
      "description": "HQ-level overview of all outlet performance, AI insights, and key metrics",
      "usedBy": ["hq_admin", "outlet_manager"],
      "layout": {
        "hasSidebar": true,
        "hasTopBar": true,
        "structure": "vertical-stack"
      },
      "elements": [
        {
          "id": "ai-daily-briefing",
          "type": "ai-card",
          "description": "AI-generated daily summary with actionable insights",
          "position": "top-full-width",
          "content": {
            "icon": "Sparkles",
            "badge": "AI Daily Briefing",
            "timestamp": "7:00 AM · Confidence 78%",
            "summary": "Yesterday: 2 of 3 outlets exceeded target; Mid Valley led at +16% MTD. 1 Utama flagged — sales down 18% vs. 30-day baseline. Stock alerts: 5 SKUs need replenishment.",
            "actions": [
              { "label": "Review 1 Utama →", "type": "primary" },
              { "label": "See full insights →", "type": "ghost", "navigatesTo": "ai-bi" },
              { "label": "👍 Helpful 👎", "type": "feedback", "position": "far-right" }
            ]
          }
        },
        {
          "id": "kpi-row",
          "type": "kpi-grid",
          "description": "4 key performance indicator cards in horizontal row",
          "position": "below-briefing",
          "layout": "4-column-grid",
          "cards": [
            {
              "label": "Sales Today",
              "value": "RM 13,350",
              "delta": "+8.2%",
              "deltaType": "positive",
              "subtext": "vs. yesterday",
              "icon": "TrendingUp"
            },
            {
              "label": "Orders Today",
              "value": "487",
              "delta": "+12.4%",
              "deltaType": "positive",
              "subtext": "vs. yesterday",
              "icon": "ShoppingCart"
            },
            {
              "label": "Active Outlets",
              "value": "3 / 3",
              "delta": "100%",
              "deltaType": "positive",
              "subtext": "all operational",
              "icon": "Store"
            },
            {
              "label": "Stock Alerts",
              "value": "5",
              "delta": "↑ 2",
              "deltaType": "warning",
              "subtext": "across 2 outlets",
              "icon": "AlertTriangle"
            }
          ]
        },
        {
          "id": "sales-trend-chart",
          "type": "chart-container",
          "description": "Area chart showing 30-day sales trend across all outlets",
          "position": "middle-left",
          "span": "2-columns",
          "content": {
            "title": "Sales Trend · Last 30 days",
            "subtitle": "All outlets combined",
            "badge": { "text": "+14.3% MoM", "type": "positive", "icon": "TrendingUp" },
            "chartType": "area-chart",
            "dataPoints": 30,
            "height": "200px",
            "gradientFill": "primary color with opacity fade",
            "features": ["responsive", "tooltip-on-hover", "RM format on Y-axis"]
          }
        },
        {
          "id": "activity-feed",
          "type": "feed-panel",
          "description": "Live activity feed showing recent events across outlets",
          "position": "middle-right",
          "span": "1-column",
          "content": {
            "title": "Activity Feed",
            "badge": "Live",
            "items": [
              { "icon": "ShoppingCart", "color": "positive", "title": "Large transaction", "desc": "RM 1,250 · Mid Valley · 14:23" },
              { "icon": "AlertTriangle", "color": "warning", "title": "Stock alert", "desc": "True Wireless Earbuds Pro at 1 Utama · 13:45" },
              { "icon": "Receipt", "color": "accent", "title": "Refund processed", "desc": "RM 87.50 · KL Sentral · 12:08" },
              { "icon": "Award", "color": "primary", "title": "New Gold customer", "desc": "Priya Nair reached 20K pts · 11:55" },
              { "icon": "Truck", "color": "inkMuted", "title": "Stock transfer", "desc": "MV → 1U · 24 units · 10:20" }
            ]
          }
        },
        {
          "id": "outlet-performance-table",
          "type": "data-table",
          "description": "Detailed outlet performance comparison table",
          "position": "bottom-full-width",
          "content": {
            "title": "Outlet Performance · This Month",
            "filter": { "label": "Klang Valley", "icon": "Filter" },
            "columns": [
              { "key": "outlet", "label": "Outlet", "type": "compound", "align": "left" },
              { "key": "today", "label": "Today", "type": "currency", "align": "right" },
              { "key": "mtd", "label": "MTD", "type": "currency", "align": "right" },
              { "key": "vsTarget", "label": "vs. Target", "type": "percentage-badge", "align": "right" },
              { "key": "topItem", "label": "Top Item", "type": "text", "align": "left" },
              { "key": "alerts", "label": "Alerts", "type": "alert-badge", "align": "center" },
              { "key": "actions", "label": "", "type": "chevron", "align": "right" }
            ],
            "rows": [
              { "outlet": "KL Sentral", "code": "KLS", "region": "Klang Valley", "today": 4820, "mtd": 142500, "vsTarget": 108, "topItem": "Ergonomic Wireless Mouse", "alerts": 1, "trend": 12 },
              { "outlet": "Mid Valley", "code": "MV", "region": "Klang Valley", "today": 5640, "mtd": 168400, "vsTarget": 116, "topItem": "Fitness Smartwatch SE", "alerts": 0, "trend": 18 },
              { "outlet": "1 Utama", "code": "1U", "region": "Klang Valley", "today": 2890, "mtd": 98200, "vsTarget": 82, "topItem": "USB-C 7-in-1 Hub", "alerts": 4, "trend": -18 }
            ],
            "features": ["hover-highlight", "click-to-drill", "conditional-formatting"]
          }
        }
      ]
    },
    "ai-bi": {
      "name": "AI Business Intelligence",
      "moduleTitlerow": {
        "lead": "Insights"
      },
      "description": "Natural language query interface for business insights with AI-generated visualizations",
      "usedBy": ["hq_admin", "outlet_manager"],
      "layout": {
        "hasSidebar": true,
        "hasTopBar": true,
        "structure": "vertical-stack"
      },
      "elements": [
        {
          "id": "nlq-hero",
          "type": "nlq-container",
          "description": "Natural language query input with suggested questions",
          "position": "top-full-width",
          "content": {
            "badge": { "icon": "Sparkles", "text": "Natural Language Query" },
            "title": "Ask anything about your franchise.",
            "subtitle": "BM · EN supported",
            "input": {
              "placeholder": "Outlet mana sales drop minggu ini?",
              "actionButton": { "label": "Ask", "icon": "Send" }
            },
            "suggestedQueries": [
              "Top 5 products this month",
              "Which outlet underperforming?",
              "Compare KL vs Mid Valley sales",
              "Forecast next week revenue"
            ]
          }
        },
        {
          "id": "ai-response",
          "type": "ai-response-card",
          "description": "AI-generated answer with visualization",
          "position": "below-nlq",
          "conditional": "shown-after-query",
          "content": {
            "header": {
              "icon": "Bot",
              "label": "AI Response",
              "confidence": "Confidence 84%"
            },
            "answer": "1 Utama outlet shows the most concerning drop this week — sales down 18% vs. its 30-day baseline (3 consecutive days). Other outlets stable or up.",
            "visualization": {
              "type": "bar-chart",
              "data": [
                { "outlet": "KL Sentral", "change": 4 },
                { "outlet": "Mid Valley", "change": 9 },
                { "outlet": "1 Utama", "change": -18 }
              ],
              "colorCoding": "positive for up, negative for down",
              "height": "140px"
            },
            "followUp": "Want to dig deeper? Try: 'Why is 1 Utama down?' or 'Show 1 Utama hourly traffic'"
          }
        },
        {
          "id": "forecast-card",
          "type": "forecast-container",
          "description": "7-day sales forecast with confidence intervals",
          "position": "bottom-left",
          "span": "1-column",
          "content": {
            "title": "7-Day Sales Forecast",
            "subtitle": "All outlets · 80% confidence interval",
            "badge": "Updated 04:00 AM",
            "chartType": "line-chart",
            "series": [
              { "name": "Actual", "style": "solid-line", "color": "ink" },
              { "name": "Forecast", "style": "dashed-line", "color": "primary" },
              { "name": "High", "style": "solid-line", "opacity": 0.3, "color": "primary" },
              { "name": "Low", "style": "solid-line", "opacity": 0.3, "color": "primary" }
            ],
            "expectedValue": "RM 41,500",
            "height": "180px"
          }
        },
        {
          "id": "anomalies-card",
          "type": "anomaly-list",
          "description": "Detected anomalies with severity levels",
          "position": "bottom-right",
          "span": "1-column",
          "content": {
            "title": "Anomalies Detected",
            "subtitle": "Last 7 days · ≥80% confidence",
            "icon": "AlertTriangle",
            "items": [
              {
                "outlet": "1 Utama",
                "description": "Sales 18% below 30-day baseline",
                "detail": "3 consecutive days · weekday afternoons",
                "severity": "high",
                "actions": ["Investigate →", "Dismiss"]
              },
              {
                "outlet": "Mid Valley",
                "description": "USB-C hub sales spike +42%",
                "detail": "Unusual for Tuesday — possible viral mention",
                "severity": "medium",
                "actions": ["Investigate →", "Dismiss"]
              },
              {
                "outlet": "KL Sentral",
                "description": "Refund rate 3× baseline",
                "detail": "Mostly True Wireless Earbuds Pro — quality issue?",
                "severity": "medium",
                "actions": ["Investigate →", "Dismiss"]
              }
            ]
          }
        }
      ]
    },
    "pos": {
      "name": "Point of Sale",
      "description": "POS interface for processing customer orders and payments",
      "usedBy": ["outlet_staff", "outlet_manager"],
      "layout": {
        "hasSidebar": false,
        "hasTopBar": true,
        "structure": "two-column-split"
      },
      "elements": [
        {
          "id": "category-tabs",
          "type": "tab-group",
          "description": "Product category filter tabs",
          "position": "top-left",
          "content": {
            "categories": ["All", "Computing", "Mobile", "Audio", "Accessories"],
            "behavior": "filter-product-grid"
          }
        },
        {
          "id": "product-grid",
          "type": "product-grid",
          "description": "Grid of product cards with stock status",
          "position": "left-main",
          "layout": "3-column-grid",
